# ---------------------------------------------------------------------------
# Legal RAG configuration. Copy to `.env` and edit. EVERY value has a safe
# default; with an empty/absent .env the system runs fully OFFLINE (mock LLM +
# mock embedder, zero downloads). Only set the USE_REAL_* flags when you have
# installed the optional dependencies and (for the LLM) a provider API key.
# ---------------------------------------------------------------------------

# --- Retrieval tunables ---
BM25_TOP_N=20            # lexical candidates per corpus before fusion
VECTOR_TOP_N=20          # dense candidates per corpus before fusion
RRF_K=60                 # Reciprocal Rank Fusion smoothing constant
RERANK_TOP_K=6           # passages kept after the cross-encoder
MAX_REGENERATE=2         # regeneration attempts before human review

# --- Model / provider selection ---
LLM_PROVIDER=anthropic                              # anthropic | openai
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Feature gates (default OFF => offline, deterministic, no downloads) ---
USE_REAL_LLM=0           # 1 => call the configured provider (needs a key)
USE_REAL_EMBEDDINGS=0    # 1 => sentence-transformers embeddings
USE_REAL_RERANKER=0      # 1 => sentence-transformers cross-encoder
EMBEDDING_DIM=256        # dimension of the offline mock embedder

# --- Vector backend ---
VECTOR_BACKEND=numpy     # numpy (in-memory, default) | qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_PREFIX=legal_rag

# --- Data ---
# DATA_DIR=/absolute/path/to/data   # defaults to <repo>/data

# --- Secrets (never commit real values) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
